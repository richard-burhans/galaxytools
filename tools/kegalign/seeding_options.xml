<macros>
    <xml name="seeding_options">
        <section name="seeding_options" expanded="false" title="Seeding Options">
            <conditional name="seed">
                <param name="seed_selector" type="select" label="Seed patern">
                    <option value="12of19" selected="true">12of19 (1110100110010101111)</option>
                    <option value="14of22">14of22 (1110101100110010101111)</option>
                    <option value="custom">custom</option>
                </param>
                <when value="12of19">
                    <!-- Do nothing -->
                </when>
                <when value="14of22">
                    <!-- Do nothing -->
                </when>
                <when value="custom">
                    <param name="custom_seed" type="text" value="" optional="false" label="Custom seed pattern">
                        <validator type="empty_field"/>
                        <validator type="regex" message="Arbitrary pattern of 1s, 0s, and Ts">^[01T]+$</validator>
                        <!-- Mirrors MAX_SEED_SPAN, MAX_SEED_WEIGHT and MIN_SEED_WEIGHT, all
                             three of which KegAlign enforces from 0.3.1. Checking here means
                             the user is told in the form rather than by a failed job, which
                             matters most at the floor: below weight 4 a Release build has had
                             its assert deleted by NDEBUG and dies with cudaErrorIllegalAddress
                             rather than a message. Weight counts 1 and T alike: the tool
                             normalises 1 to T before counting them. -->
                        <validator type="expression" message="Seed pattern may be at most 64 positions long">len(value) &lt;= 64</validator>
                        <validator type="expression" message="Seed pattern must have between 4 and 15 match positions (1 or T)">4 &lt;= sum(c in "1T" for c in value) &lt;= 15</validator>
                        <sanitizer invalid_char="">
                            <valid initial="none">
                                <add value="0"/>
                                <add value="1"/>
                                <add value="T"/>
                            </valid>
                        </sanitizer>
                    </param>
                </when>
            </conditional>
            <param argument="--step" type="integer" value="1" min="1" label="Offset between the starting positions of successive target words considered for generating seed table"/>
            <param argument="--notransition" type="boolean" checked="false" label="Don't allow one transition in a seed hit"/>
        </section>
    </xml>
</macros>
