<tool id="ncbi_egapx" name="NCBI EGAPx" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>annotates eukaryotic genomes</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="edam_ontology"/>
    <expand macro="xrefs"/>
    <expand macro="requirements"/>
    <required_files>
        <include path="get-bams.bash"/>
        <include path="prepare_egapx_config.py"/>
    </required_files>
    <expand macro="version_command"/>
    <command detect_errors="aggressive"><![CDATA[
    ## Activate Nextflow conda environment and EGAPx Python virtual environment
    source /galaxy/env.bash &&
    python3 '$__tool_directory__/prepare_egapx_config.py'
        --output-yaml 'egapx.yaml'
        --extra-yaml-file '$extra_yaml_file'
        #if str($cond_input_style.input_style) == "fillform"
            --stage-dir 'galaxy_staged'
            @PREPARE_FILLFORM_ARGS@
        #else
            --base-yaml '$cond_input_style.yamlin'
        #end if
    &&
    python3 /galaxy/scripts/galaxy-resource-config.py &&
    python3 /galaxy/egapx/ui/egapx.py
    #if str($developer.query_limit.query_limit_selector) == "false"
        --force
    #end if
    'egapx.yaml' --executor galaxy --output 'egapx_out'
    #if str($developer.collect_star_bams) == "true"
        && bash '$__tool_directory__/get-bams.bash'
    #end if
    ]]></command>
    <environment_variables>
        <environment_variable name="NXF_DEBUG">3</environment_variable>
        <environment_variable name="EGAPX_RNASEQ_QUERY_LIMIT">$getVar('developer.query_limit.rnaseq_query_limit', '20')</environment_variable>
        <environment_variable name="EGAPX_GIGABASE_PAIRS">$getVar('developer.gigabase_pairs', '1')</environment_variable>
    </environment_variables>
    <configfiles>
        <configfile name="extra_yaml_file"><![CDATA[$developer.extra_yaml]]></configfile>
    </configfiles>
    <inputs>
        <expand macro="cond_input_style"/>
        <expand macro="developer_annotation_options"/>
    </inputs>
    <expand macro="annotation_outputs"/>
    <tests>
        <!--
            expect_num_outputs = datasets + top-level collections known at job
            submission, so discovered collection elements (multiqc_report,
            rnaseq_stats, star_alignments) are NOT counted and the total is fixed:
              1 complete_genomic_gff + 19 output_files + 5 nextflow_stats
            + 5 collections (output_files, nextflow_stats, multiqc_report,
              rnaseq_stats, star_alignments) = 30
            + 1 filtered_protein_alignments when collect_protein_alignments=true
            These full-pipeline tests require multi-CPU/high-RAM hardware, hence
            expect_test_failure="true" for CI.
        -->
        <test expect_num_outputs="30" expect_test_failure="true">
            <conditional name="cond_input_style">
                <param name="input_style" value="fillform"/>
                <conditional name="cond_genome_style">
                    <param name="genome_style" value="uri"/>
                    <param name="uri" value="https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/020/809/275/GCF_020809275.1_ASM2080927v1/GCF_020809275.1_ASM2080927v1_genomic.fna.gz"/>
                </conditional>
                <param name="taxid" value="6954"/>
                <conditional name="cond_short_reads_style">
                    <param name="short_reads_style" value="list"/>
                    <param name="short_reads" value="https://ftp.ncbi.nlm.nih.gov/genomes/TOOLS/EGAP/sample_data/Dermatophagoides_farinae_small/SRR8506572_1.gz https://ftp.ncbi.nlm.nih.gov/genomes/TOOLS/EGAP/sample_data/Dermatophagoides_farinae_small/SRR8506572_2.gz https://ftp.ncbi.nlm.nih.gov/genomes/TOOLS/EGAP/sample_data/Dermatophagoides_farinae_small/SRR9005248_1.gz https://ftp.ncbi.nlm.nih.gov/genomes/TOOLS/EGAP/sample_data/Dermatophagoides_farinae_small/SRR9005248_2.gz"/>
                </conditional>
            </conditional>
            <section name="developer">
                <param name="collect_star_bams" value="true"/>
                <conditional name="query_limit">
                    <param name="query_limit_selector" value="true"/>
                    <param name="rnaseq_query_limit" value="20"/>
                </conditional>
            </section>
            <expand macro="test_outputs"/>
        </test>
        <!-- expect_num_outputs: see note above (31 = 30 + filtered_protein_alignments). -->
        <test expect_num_outputs="31" expect_test_failure="true">
            <conditional name="cond_input_style">
                <param name="input_style" value="history"/>
                <param name="yamlin" value="input.yaml"/>
            </conditional>
            <section name="developer">
                <param name="collect_star_bams" value="true"/>
                <param name="collect_protein_alignments" value="true"/>
                <conditional name="query_limit">
                    <param name="query_limit_selector" value="true"/>
                    <param name="rnaseq_query_limit" value="20"/>
                </conditional>
            </section>
            <expand macro="test_outputs"/>
            <output name="filtered_protein_alignments" ftype="asn1">
                <assert_contents>
                    <has_size min="1"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
NCBI EGAPx: Eukaryotic Genome Annotation Pipeline
=================================================

What it does
============

Annotates a eukaryotic genome assembly with `EGAPx <https://github.com/ncbi/egapx>`_ in a single step (EGAPx *online mode*).
EGAPx support data and any remote inputs are downloaded from NCBI, BUSCO lineage data from busco-data.ezlab.org, and SRA reads from NCBI SRA during the run,
so the compute node running the job needs Internet access.

Configure the run with the tool form, or supply an EGAPx YAML configuration from your history.

To separate the downloads from the long annotation run, or to make the annotation reproducible, use **NCBI EGAPx prepare input**
to download a local cache, then **NCBI EGAPx execute** to run the annotation against it.

@HELP_OVERVIEW@

@HELP_RESOURCES@

@HELP_GENOME@

@HELP_FORM@

@HELP_YAML@

@HELP_OUTPUT@

@HELP_MORE@
    ]]></help>
    <expand macro="citations"/>
    <expand macro="creators"/>
</tool>
