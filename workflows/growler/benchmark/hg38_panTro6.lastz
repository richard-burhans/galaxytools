# UCSC hg38 x panTro6 lastz scoring (the Q parameter), from
# https://hgdownload2.soe.ucsc.edu/goldenPath/hg38/vsPanTro6/README.txt (run 2018-03):
#   "The lastz scoring matrix (Q parameter) used was: ... with a gap open penalty of O=600
#    and a gap extension penalty of E=150."
gap_open_penalty   = 600
gap_extend_penalty = 150
      A     C     G     T
A    90  -330  -236  -356
C  -330   100  -318  -236
G  -236  -318   100  -330
T  -356  -236  -330    90
